{
  "name": "global-cache-monorepo",
  "private": true,
  "version": "0.5.1",
  "packageManager": "pnpm@12.11.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vitalets/global-cache.git"
  },
  "scripts": {
    "lint": "eslint .",
    "tsc": "npm run build && tsc",
    "prettier": "prettier --check --ignore-unknown .",
    "prettier:w": "prettier --write --ignore-unknown .",
    "pw:install": "PLAYWRIGHT_SKIP_BROWSER_GC=1 npx playwright install chromium",
    "toc": "turbo toc",
    "dev": "turbo watch build",
    "build": "turbo run build",
    "docs": "pnpm --filter @global-cache/website start",
    "docs:build": "pnpm --filter @global-cache/website build",
    "deps": "npx npm-check-updates -i -p pnpm --packageFile=\"{package.json,packages/*/package.json,website/package.json}\" --format group,dep,repo --cooldown 1",
    "test": "turbo run test --filter='./packages/*'"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@release-it/keep-a-changelog": "^8.0.1",
    "@types/node": "^20.19.19",
    "eslint": "^10.12.0",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-visual-complexity": "0.1.4",
    "globals": "^17.13.0",
    "knip": "^6.41.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "release-it": "^21.1.1",
    "remark-cli": "^12.0.1",
    "remark-section-toc": "^1.0.0",
    "remark-toc": "^9.0.0",
    "remark-validate-links": "^13.1.0",
    "turbo": "2.11.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  },
  "prettier": {
    "tabWidth": 2,
    "useTabs": false,
    "singleQuote": true,
    "printWidth": 100,
    "semi": true,
    "trailingComma": "all",
    "bracketSpacing": true
  },
  "remarkConfig": {
    "plugins": [
      "remark-section-toc",
      [
        "remark-toc",
        {
          "heading": "Index",
          "maxDepth": 3
        }
      ],
      "remark-validate-links"
    ]
  }
}
