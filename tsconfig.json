{
  "compilerOptions": {
    "target": "es2021",
    "module": "nodenext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "useUnknownInCatchVariables": false,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["**/*.ts", ".release-it.ts"],
  "exclude": ["node_modules", "packages"]
}
